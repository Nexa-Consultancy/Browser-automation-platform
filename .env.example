# Copy to .env and adjust as needed. docker-compose.yml already wires these
# for the containerized services; this file is for local (non-docker) dev.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=qa_automation
POSTGRES_USER=qa_automation
POSTGRES_PASSWORD=qa_automation

REDIS_URL=redis://localhost:6379

API_PORT=4000
API_BASE_URL=http://localhost:4000

# How many test-job "runs" a single worker process can *start* at once.
# This is dispatch throughput only, not a cap on simultaneously-live runs —
# starting a run doesn't hold this slot for the run's lifetime (a run can
# stay parked for hours waiting on a human or a video). Each run launches
# its own Chromium instance and fans out to that job's own per-user
# concurrency setting (chosen per job, capped at 50 by the API).
WORKER_JOB_CONCURRENCY=10

# Default cap for "wait for video to end" so a broken page can't hang a
# session forever. 3 hours is comfortably above the "1-2 hour meeting" case.
MAX_VIDEO_WAIT_MS=10800000

# Region for scheduled groups. Groups fire on wall-clock times ("start at
# 17:00, stop at 21:00"), and a container's clock is UTC unless you set this
# — so leave it unset only if UTC really is the region you mean. Use an IANA
# zone name, e.g. Asia/Kolkata, Europe/London, America/New_York. The
# dashboard displays whichever zone is in effect alongside every group.
TZ=UTC

# How often the API re-checks whether a group's window has opened or closed.
# Lower means a group starts closer to its exact minute, at the cost of more
# (very cheap) polling.
GROUP_SCHEDULER_TICK_MS=20000
