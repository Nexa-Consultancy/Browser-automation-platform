# Microsoft Azure/Entra ID Configuration for Teams Auth
# Copy values from your Azure Portal: Azure Active Directory -> Enterprise Applications

TEMS_TENANT_ID=your-company-com-on-microsoft-com
TEAMS_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
TEAMS_CLIENT_SECRET=your-client-secret-here

# Corporate Teams browser profile (saved in /app/data/browsers)
DEFAULT_TEAMS_USER=share@company.onmicrosoft.com

# Browser data directory (Docker volume or local path)
BROWSER_DATA_DIR=/app/data/browsers

# Enable shared auth cache - all browsers will use same MS tokens
ENABLE_SHARED_AUTH=true

# Session timeout (ms) - 30 days to avoid re-login
AUTH_SESSION_TIMEOUT=2592000000
